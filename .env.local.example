# Copy this file to .env.local and fill in the values.
# See ADMIN-PORTAL-SETUP.md for where to get each value.

# Supabase — project ahlejuecgdwrmfexcamz
NEXT_PUBLIC_SUPABASE_URL=https://ahlejuecgdwrmfexcamz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — for concierge email notifications on new leads
RESEND_API_KEY=
LEAD_NOTIFY_TO=reservations@giovannivillage.com
LEAD_NOTIFY_FROM=Giovanni Website <noreply@giovannivillage.com>

# Google Sheets — for the read-only mirror of the Banquet & Room Enquiry sheet.
# Paste the entire service-account JSON as a single line. See ADMIN-PORTAL-SETUP.md §8.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Vercel Cron secret — protects /api/sync/sheets when called by Cron.
# Local dev: any string. Production: also set in Vercel env vars.
CRON_SECRET=

# ── Admin portal auth (all three REQUIRED; login fails closed without them) ──
# ADMIN_AUTH_SECRET — ≥32 random chars; HMACs the admin session cookie.
#   Generate: openssl rand -hex 32
ADMIN_AUTH_SECRET=
# ADMIN_ACCESS_CODE — the shared second factor typed at login (≥8 chars).
#   A phone number alone is NOT authentication; this code is the real gate.
#   Generate: openssl rand -hex 12   — share it with authorised staff only.
ADMIN_ACCESS_CODE=
# ADMIN_PHONE_WHITELIST — comma-separated 10-digit Indian mobile numbers
#   allowed to sign in. Empty ⇒ nobody can sign in (no hardcoded fallback).
ADMIN_PHONE_WHITELIST=
